# ============================================================
# THE-PANDORA — Environment Variables
# ============================================================
# For LOCAL development: copy this file to `.env` and fill in values.
# NEVER commit the real `.env` — it is gitignored.
#
# For DEPLOYMENT: set these as environment variables on your
# platform (Render / Railway / Docker) — do NOT upload the .env file.
# ============================================================

# ============================================================
# LLM PROVIDER KEYS  (at least ONE is required)
# The backend builds a failover chain in this order:
#   NVIDIA (primary) -> OpenRouter (secondary) -> Gemini (fallback)
# Unset providers are skipped automatically.
# ============================================================

# --- NVIDIA NIM (primary, preferred) ---
NVIDIA_API_KEY=
# Optional model override (default: meta/llama-3.3-70b-instruct)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- OpenRouter (secondary, free-tier friendly) ---
# Single key configuration:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Multi-key failover pairs (optional, up to 9 pairs):
OPENROUTER_API_KEY_1=
OPENROUTER_MODEL_1=openrouter/free
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL_2=openrouter/free
# ... up to OPENROUTER_API_KEY_9 / OPENROUTER_MODEL_9

# --- Google Gemini (legacy fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# FRONTEND (build-time only)
# ============================================================
# The React app reads this at BUILD time via import.meta.env.
#
#   - Single-service deployment (FastAPI serves the SPA; the
#     provided Dockerfile does this): leave EMPTY "".
#   - Local dev (Vite proxy): leave EMPTY "".
#   - Two-service deployment (frontend on Vercel/Netlify,
#     backend on Render/Railway): set to the deployed backend URL,
#     e.g. https://the-pandora-backend.onrender.com
#     (no trailing slash).
VITE_API_BASE_URL=

# ============================================================
# BACKEND CORS (two-service deployments only)
# ============================================================
# Comma-separated list of allowed browser origins. Only needed
# when the React SPA is served from a DIFFERENT origin than the
# FastAPI backend.
# Example: CORS_ORIGINS=https://my-frontend.vercel.app,https://localhost:5173
CORS_ORIGINS=

# ============================================================
# SERVER
# ============================================================
# Port for the web server. Render / Railway / Docker inject $PORT
# automatically — you normally DON'T set this in production.
# Used as fallback for local runs when $PORT is not defined.
PORT=8000